Options -Indexes

# Somente o front controller executa PHP.
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "api.php">
    Require all granted
</Files>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    # A API e o callback não devem ir para o índice dos buscadores.
    <Files "api.php">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
    <FilesMatch "\.(png|svg|webmanifest)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Mitigações PHP2Shell (mod_php). Em PHP-FPM/CGI vale o .user.ini.
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled off
    php_flag display_errors off
</IfModule>
<IfModule mod_php8.c>
    php_flag session.upload_progress.enabled off
    php_flag display_errors off
</IfModule>
